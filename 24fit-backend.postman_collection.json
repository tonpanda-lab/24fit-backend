    {
      "name": "\ud83d\udd04 Sync (Protected)",
      "item": [
        {
          "name": "Push Profile",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"server_user_id\": \"{{user_id}}\",\n  \"profile\": {\n    \"name\": \"Test User\",\n    \"age\": 30,\n    \"weight_kg\": 70,\n    \"height_cm\": 175,\n    \"goal\": \"maintain\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/sync/profile",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "sync",
                "profile"
              ]
            },
            "description": "Push user profile. Requires Bearer token from Login/Register."
          },
          "response": []
        },
        {
          "name": "Push Meal",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"server_user_id\": \"{{user_id}}\",\n  \"date\": \"2024-01-15\",\n  \"item\": \"Oatmeal\",\n  \"total_calories\": 300\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/sync/meals",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "sync",
                "meals"
              ]
            },
            "description": "Push a simple meal log (date, item, total_calories). Requires Bearer token. Returns server_meal_id."
          },
          "response": []
        },
        {
          "name": "Get Sync Data",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/sync/data?server_user_id={{user_id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "sync",
                "data"
              ],
              "query": [
                {
                  "key": "server_user_id",
                  "value": "{{user_id}}"
                }
              ]
            },
            "description": "Fetch all user data (profile + meals). Requires Bearer token."
          },
          "response": []
        }
      ]
    },
    {
      "name": "\ud83d\udcd6 Read (Protected)",
      "item": [
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/profile",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "profile"
              ]
            },
            "description": "Retrieve the authenticated user's stored profile."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response has profile field', () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('profile');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get History",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/history?page=1&limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "history"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            },
            "description": "Retrieve paginated meal history for the authenticated user."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response has meals and pagination', () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('meals');",
                  "    pm.expect(json).to.have.property('pagination');",
                  "    pm.expect(json.pagination).to.have.property('page');",
                  "    pm.expect(json.pagination).to.have.property('total');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "\ud83e\uddea Test Scenarios",
      "item": [
