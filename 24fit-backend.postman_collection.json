                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/v1/sync/data?server_user_id={{user_id}}",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "v1",
                    "sync",
                    "data"
                  ],
