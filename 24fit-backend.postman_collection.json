                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"server_user_id\": \"{{user_id}}\",\n  \"date\": \"2024-01-15\",\n  \"item\": \"Rice\",\n  \"total_calories\": 200\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/v1/sync/meals",
